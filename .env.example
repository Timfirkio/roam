# Roam's public client values are already in the tracked .env. Use this template
# only when configuring a different Supabase project in ignored .env.local.
# Never put a secret or service-role key in a VITE_ variable.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Enables the stored PostGIS OSM catalog and boundary-vector-tile layer.
VITE_AREA_CATALOG=true
# Leave this unset in development: Vite proxies /api/areas to the hosted
# catalog by default. Set VITE_AREA_API_URL only for a separately hosted API.
# To use a configured local worker instead, set AREA_API_PROXY_TARGET=http://127.0.0.1:8787.
